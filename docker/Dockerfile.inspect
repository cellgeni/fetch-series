# syntax=docker/dockerfile:1.7
# fetch-series with the readers `fetch inspect` needs for CRAM and SRA objects.
#
# A second image, so the main one keeps its promise: it resolves accessions and
# emits links.tsv, and carries no SRA toolkit. This one adds pysam (the
# `[inspect]` extra, for CRAM) and sra-tools (for SRA objects, read by URL with
# `fastq-dump -X N --split-files`). FASTQ and BAM need neither; without these a
# CRAM or an SRA object is reported undetermined, never unfit.
#
# Build:
#   docker build -t fetch-series-inspect:0.1.0 -f docker/Dockerfile.inspect .

FROM python:3.13-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

WORKDIR /src
# Built at the path it is used from, for the reason docker/Dockerfile gives.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock README.md LICENCE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra inspect

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --extra inspect

# sra-tools, pinned and checked. NCBI publishes the tarball and an md5 list;
# the sha256 here was computed from the download on 2026-10-19 and a tarball
# that does not match fails the build rather than ship a different toolkit.
ARG SRA_TOOLS=3.4.1
ARG SRA_TOOLS_SHA256=b950362c054765a4184af41947f022f040e94e964862017c0ecb0b0273db3596
ADD --checksum=sha256:${SRA_TOOLS_SHA256} \
    https://ftp-trace.ncbi.nlm.nih.gov/sra/sdk/${SRA_TOOLS}/sratoolkit.${SRA_TOOLS}-ubuntu64.tar.gz \
    /tmp/sratoolkit.tar.gz
RUN mkdir -p /opt/sratoolkit \
    && tar -xzf /tmp/sratoolkit.tar.gz -C /opt/sratoolkit --strip-components=1


FROM python:3.13-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/sratoolkit/bin /opt/sratoolkit/bin
ENV PATH="/opt/venv/bin:/opt/sratoolkit/bin:$PATH"

# sra-tools wants a configuration before it will run; this is the
# non-interactive form, with remote access on and no local cache, because a
# prefix read streams and keeps nothing. It lives outside any home directory
# and is world-readable: Nextflow runs the container as the invoking user.
RUN mkdir -p /opt/ncbi \
    && printf '/LIBS/GUID = "%s"\n/repository/remote/disabled = "false"\n/repository/user/cache-disabled = "true"\n' \
       "$(cat /proc/sys/kernel/random/uuid)" > /opt/ncbi/user-settings.mkfg \
    && chmod -R a+rX /opt/ncbi
ENV VDB_CONFIG=/opt/ncbi

WORKDIR /work

# The key is never declared here, for the reason docker/Dockerfile gives.

# The build fails if either reader is unreachable: an image that cannot read a
# CRAM or an SRA object is the main image under another name.
ARG SRA_TOOLS=3.4.1
RUN set -eu; \
    version="$(fetch --version)"; \
    test -n "$version"; \
    fastq-dump --version | grep -q "${SRA_TOOLS}"; \
    python -c "import pysam"; \
    printf 'fetch-series: %s\nsra-tools: %s\n' "$version" "${SRA_TOOLS}" > /versions.txt

ENTRYPOINT ["fetch"]
CMD ["--help"]
